# Places in Artsdata.ca core dataset

PREFIX schema: <http://schema.org/>
PREFIX adp: <http://kg.artsdata.ca/plugin#>
PREFIX ado: <http://kg.artsdata.ca/ontology/>

SELECT  ?ArtsdataID ?name  ?locality  ?containedIn ?WikidataID 

WHERE {
  
  ?ArtsdataID a ado:Place  .

  BIND(adp:prefLangLiteral(?ArtsdataID, schema:name, "fr en") AS ?name)  
  OPTIONAL { ?ArtsdataID schema:containedInPlace ?containedIn }
  OPTIONAL { ?ArtsdataID schema:sameAs ?WikidataID . filter (regex(str(?WikidataID), "wikidata.org/entity")) }
  
  ?ArtsdataID schema:address ?address .
  BIND(adp:prefLangLiteral(?address, schema:addressLocality, "fr") AS ?locality)  
} 

ORDER BY ASC(?ArtsdataID)

LIMIT 100